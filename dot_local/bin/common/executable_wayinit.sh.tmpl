#!/bin/bash

tmux new-session -d
tmux new-window -d 'easyeffects --service-mode'
tmux new-window -d 'ydotoold'
tmux new-window -d -c ~/.local/share/ccx/ './ccx'
tmux new-window -d 'flameshot'

if [[ "$XDG_CURRENT_DESKTOP" != "KDE" ]]; then
  tmux new-window -d {{ .user.programs.notification }}
  tmux new-window -d {{ .user.programs.idle }}
  tmux new-window -d 'fcitx5 -Dr'
  tmux new-window -d wob.sh

  sleep 5
  xrdb ~/.Xresources
fi
